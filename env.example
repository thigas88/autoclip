# Exemplo de Configuração de Variáveis ​​de Ambiente do AutoClip
# Copie este arquivo para .env e preencha com as configurações reais

# Configuração do Banco de Dados
DATABASE_URL=sqlite:///./data/autoclip.db

# Configuração do Redis
REDIS_URL=redis://localhost:6379/0

# Configuração da API
# Preencha com sua chave de API real do DashScope (ou outro provedor)
DASHSCOPE_API_KEY=sua_chave_api_dashscope_aqui
LLM_PROVIDER=dashscope
MODEL_NAME=qwen-plus
API_MAX_TOKENS=4096
API_TIMEOUT=30

# Configuração de Processamento
PROCESSING_CHUNK_SIZE=5000
PROCESSING_MIN_SCORE_THRESHOLD=0.7
PROCESSING_MAX_CLIPS_PER_COLLECTION=5
PROCESSING_MAX_RETRIES=3

# Configuração de Caminhos (Opcional; o sistema os detectará automaticamente)
# PATH_PROJECT_ROOT=
# PATH_DATA_DIR=
# PATH_UPLOADS_DIR=
# PATH_TEMP_DIR=
# PATH_OUTPUT_DIR=

# Configuração de Logs
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=backend.log

# Configuração de Ambiente
ENVIRONMENT=development
DEBUG=true